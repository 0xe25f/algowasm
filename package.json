{
  "name": "algowasm-workspace",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0xe25f/algowasm.git"
  },
  "homepage": "https://github.com/0xe25f/algowasm#readme",
  "bugs": {
    "url": "https://github.com/0xe25f/algowasm/issues"
  },
  "workspaces": [
    "packages/algo-wasm",
    "examples/vanilla",
    "examples/react",
    "examples/phaser"
  ],
  "scripts": {
    "generate:profiles": "node scripts/generate-profiles.mjs",
    "build": "npm run generate:profiles && npm run build:wasm && npm run build:ts",
    "build:wasm": "node scripts/build-wasm.mjs",
    "build:ts": "node scripts/build-package.mjs",
    "build:demo": "node scripts/build-demo.mjs",
    "test": "npm run build && npm run test:package",
    "test:package": "node --test test/package/*.test.mjs",
    "test:rust": "cargo test --workspace",
    "test:browser": "playwright test",
    "lint": "npm run lint:indent && npm run lint:spelling && npm run lint:profiles",
    "lint:indent": "node scripts/check-indentation.mjs",
    "lint:spelling": "node scripts/check-british-english.mjs",
    "lint:profiles": "node scripts/generate-profiles.mjs --check",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "binaryen": "^132.0.0",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
